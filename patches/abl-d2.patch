 static sds admitSelected(sds s, size_t len, uint64_t h) {
     st.sampled++;
+    observe(0);
+    if (len != 1) return s;
     if (unlikely(filterMayHave(h))) {
         sds r = admitFromTables(s, len, h);
         if (r) return r;
