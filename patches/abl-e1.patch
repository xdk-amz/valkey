From ce91dd3ce2d8b74a6469b393c4a7eacff9db92bc Mon Sep 17 00:00:00 2001
From: abl <abl@local>
Date: Fri, 16 Oct 2026 19:52:12 +0000
Subject: [PATCH] ablate: IO selections (fixed 1/64) reach main, which discards
 them

---
 src/intern.c | 6 +-----
 1 file changed, 1 insertion(+), 5 deletions(-)

diff --git a/src/intern.c b/src/intern.c
index 614fecafa..0f99f60ac 100644
--- a/src/intern.c
+++ b/src/intern.c
@@ -982,7 +982,7 @@ static robj *parseArgIO(internPending **pp, const char *buf, size_t len, int arg
     /* The command name and, usually, the key come first; values follow. */
     int sampled = 0;
     if (argi >= 2 && --io_sel_tick == 0) {
-        io_sel_tick = 1u << __atomic_load_n(&intern_level, __ATOMIC_RELAXED);
+        io_sel_tick = 64;
         sampled = 1;
     }
     uint64_t m = hotMix(buf, len);
@@ -1102,10 +1102,6 @@ void internReadCollected(internPending *pending, uint32_t *epoch) {
         for (; pending->hits; pending->hits--) observe(1);
     }
     if (pending && pending->ns) {
-        for (uint32_t i = 0; i < pending->ns; i++) {
-            internSelected *e = &pending->sel[i];
-            objectSetVal(e->o, admitSelected(objectGetVal(e->o), e->len, e->hash));
-        }
         pending->ns = 0;
     }
     /* A long pipeline grows the arrays; do not keep them for an idle client. */
-- 
2.50.1

