From 134dcd2a08f40a45a46c767c7e893760d7aa2cb2 Mon Sep 17 00:00:00 2001
From: abl <abl@local>
Date: Fri, 16 Oct 2026 19:52:24 +0000
Subject: [PATCH] ablate: IO threads fill a pending selection (fixed 1/64) but
 never hand it over

---
 src/intern.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/intern.c b/src/intern.c
index 614fecafa..f512beb88 100644
--- a/src/intern.c
+++ b/src/intern.c
@@ -982,7 +982,7 @@ static robj *parseArgIO(internPending **pp, const char *buf, size_t len, int arg
     /* The command name and, usually, the key come first; values follow. */
     int sampled = 0;
     if (argi >= 2 && --io_sel_tick == 0) {
-        io_sel_tick = 1u << __atomic_load_n(&intern_level, __ATOMIC_RELAXED);
+        io_sel_tick = 64;
         sampled = 1;
     }
     uint64_t m = hotMix(buf, len);
@@ -1000,9 +1000,9 @@ static robj *parseArgIO(internPending **pp, const char *buf, size_t len, int arg
     if (!sampled) return NULL;
     internPending *p = pendingGet(pp);
     if (!pendingGrow((void **)&p->sel, p->ns, &p->scap, sizeof(internSelected))) return NULL;
-    robj *o = createStringObject(buf, len);
-    p->sel[p->ns++] = (internSelected){o, internHash(buf, len), len};
-    return o;
+    p->sel[p->ns++] = (internSelected){NULL, internHash(buf, len), len};
+    p->ns--;
+    return NULL;
 }
 
 robj *internParseArg(internPending **pending, const char *buf, size_t len, int argi) {
-- 
2.50.1

