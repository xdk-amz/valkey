From 311000064b88657c720a99d56147f6033ed2e0ce Mon Sep 17 00:00:00 2001
From: Dante Knowles <xdk@amazon.com>
Date: Fri, 16 Oct 2026 17:41:28 +0000
Subject: [PATCH 1/2] ablate: IO threads look up the hot cache but never select

---
 src/intern.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/intern.c b/src/intern.c
index 614fecafa..4b92181be 100644
--- a/src/intern.c
+++ b/src/intern.c
@@ -983,7 +983,7 @@ static robj *parseArgIO(internPending **pp, const char *buf, size_t len, int arg
     int sampled = 0;
     if (argi >= 2 && --io_sel_tick == 0) {
         io_sel_tick = 1u << __atomic_load_n(&intern_level, __ATOMIC_RELAXED);
-        sampled = 1;
+        sampled = 0;
     }
     uint64_t m = hotMix(buf, len);
     hotSlotEntry *e = &hot[m >> (64 - HOT_BITS)];
-- 
2.50.1


From df9f884a37d2d785fdc9db65009a7c4445c45212 Mon Sep 17 00:00:00 2001
From: abl <abl@local>
Date: Fri, 16 Oct 2026 20:29:15 +0000
Subject: [PATCH 2/2] ablate: no IO selection; setKey samples IO-parsed values
 on main

---
 src/db.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/db.c b/src/db.c
index 3b6a84b63..c8a837798 100644
--- a/src/db.c
+++ b/src/db.c
@@ -474,7 +474,7 @@ void setKey(client *c, serverDb *db, robj *key, robj **valref, int flags) {
      * an IO thread parsed is not offered here: its bytes are not in this
      * thread's cache, and IO threads select and hash such arguments instead.
      * A write that is not due for sampling only counts down the gate. */
-    if (internGateDue() && (c == NULL || !c->intern_io_parsed)) dbInternDueValue(*valref);
+    if (internGateDue()) dbInternDueValue(*valref);
     bgIteration_dbEntryModified(*valref);
     if (!(flags & SETKEY_KEEPTTL)) removeExpire(db, key);
     if (!(flags & SETKEY_NO_SIGNAL)) signalModifiedKey(c, db, key);
-- 
2.50.1

