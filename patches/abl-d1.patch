From 1a9a1ac9a671d2d8d1ff8968ebd92d1a4cfdb6c4 Mon Sep 17 00:00:00 2001
From: abl <abl@local>
Date: Fri, 16 Oct 2026 19:37:34 +0000
Subject: [PATCH] ablate: IO threads select and hash at a fixed 1/64, then drop
 the selection

---
 src/intern.c | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/src/intern.c b/src/intern.c
index 614fecafa..9ec2173c2 100644
--- a/src/intern.c
+++ b/src/intern.c
@@ -976,13 +976,14 @@ static int pendingGrow(void **arr, uint32_t n, uint32_t *cap, size_t entry) {
 /* Each IO thread selects one eligible argument in 2^level, the main sampling
  * rate, and hashes it, since the main thread does not have its bytes in cache. */
 static __thread uint32_t io_sel_tick = 1;
+static __thread volatile uint64_t abl_sink;
 
 static robj *parseArgIO(internPending **pp, const char *buf, size_t len, int argi) {
     if (len < INTERN_MIN_LEN || len > INTERN_MAX_LEN) return NULL;
     /* The command name and, usually, the key come first; values follow. */
     int sampled = 0;
     if (argi >= 2 && --io_sel_tick == 0) {
-        io_sel_tick = 1u << __atomic_load_n(&intern_level, __ATOMIC_RELAXED);
+        io_sel_tick = 64;
         sampled = 1;
     }
     uint64_t m = hotMix(buf, len);
@@ -998,6 +999,8 @@ static robj *parseArgIO(internPending **pp, const char *buf, size_t len, int arg
         return o;
     }
     if (!sampled) return NULL;
+    abl_sink += internHash(buf, len);
+    if (abl_sink != 1) return NULL;
     internPending *p = pendingGet(pp);
     if (!pendingGrow((void **)&p->sel, p->ns, &p->scap, sizeof(internSelected))) return NULL;
     robj *o = createStringObject(buf, len);
-- 
2.50.1

